{
  "name": "maxlabel",
  "version": "1.0.23",
  "description": "MaxLabel —— 桌面端条码标签设计打印软件（LabelShop 操作兼容）",
  "main": "./out/main/index.js",
  "author": "MaxLabel",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:installer": "node scripts/installer-license.test.cjs && node scripts/installer-uninstall.test.cjs",
    "test": "npm run typecheck && npm run typecheck:test && vitest run",
    "test:unit": "vitest run --project unit",
    "test:contracts": "vitest run --project contracts",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:spike": "npm run build && playwright test tests/e2e/spike.spec.ts --reporter=list",
    "test:release": "node scripts/installer-license.test.cjs && node scripts/installer-uninstall.test.cjs",
    "build:win": "node scripts/build-windows.cjs",
    "build:mac": "node scripts/build-macos.cjs",
    "build:linux": "node scripts/build-linux.cjs",
    "publish:update": "node scripts/publish-update.cjs",
    "fixtures:print": "esbuild scripts/generate-protocol-fixtures.ts --bundle --platform=node --format=cjs --outfile=scripts/_fixtures.cjs && node scripts/_fixtures.cjs && node -e \"require('fs').unlinkSync('scripts/_fixtures.cjs')\""
  },
  "build": {
    "appId": "com.maxlabel.app",
    "productName": "MaxLabel",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/iconv-lite/**/*",
      "node_modules/serialport/**/*",
      "node_modules/@serialport/**/*",
      "node_modules/usb/**/*",
      "node_modules/node-gyp-build/**/*",
      "node_modules/node-addon-api/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/sax/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/universalify/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://new.yuwangchenfa.com/updates/"
    },
    "asar": true,
    "npmRebuild": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MaxLabel-Setup-${version}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MaxLabel"
    },
    "asarUnpack": [
      "node_modules/serialport/**/*",
      "node_modules/@serialport/**/*",
      "node_modules/usb/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "MaxLabel-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "artifactName": "MaxLabel-${version}-${arch}.${ext}",
      "maintainer": "MaxLabel"
    }
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "bwip-js": "^4.4.1",
    "electron-updater": "^6.8.11",
    "fabric": "7.4.0",
    "iconv-lite": "^0.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialport": "^13.0.0",
    "usb": "^2.19.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bwip-js": "^3.0.7",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "typescript": "^5.5.4",
    "vite": "^7.3.6",
    "vitest": "^5.0.5",
    "ws": "^8.21.3"
  },
  "homepage": "https://new.yuwangchenfa.com"
}
