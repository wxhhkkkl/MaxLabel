{
  "name": "maxlabel",
  "version": "0.1.0",
  "description": "MaxLabel —— 桌面端条码标签设计打印软件（LabelShop 操作兼容）",
  "main": "./out/main/index.js",
  "author": "MaxLabel",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:render": "electron scripts/render-regression.cjs",
    "test:workspace": "electron scripts/workspace-regression.cjs",
    "test:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-regression.ps1",
    "test:editor": "esbuild scripts/editor-operations.test.ts --bundle --platform=node --format=cjs --outfile=scripts/_editor.cjs && node scripts/_editor.cjs && node -e \"require('fs').unlinkSync('scripts/_editor.cjs')\"",
    "test:geometry": "esbuild scripts/editor-geometry.test.ts --bundle --platform=node --format=cjs --outfile=scripts/_geometry-test.cjs && node scripts/_geometry-test.cjs && node -e \"require('fs').unlinkSync('scripts/_geometry-test.cjs')\"",
    "test:label-spec": "esbuild scripts/label-spec.test.ts --bundle --platform=node --format=cjs --outfile=scripts/_label-spec.cjs && node scripts/_label-spec.cjs && node -e \"require('fs').unlinkSync('scripts/_label-spec.cjs')\"",
    "test:label-formats": "esbuild scripts/label-formats.test.ts --bundle --platform=node --format=cjs --outfile=scripts/_label-formats.cjs && node scripts/_label-formats.cjs && node -e \"require('fs').unlinkSync('scripts/_label-formats.cjs')\"",
    "test:history": "esbuild scripts/document-history.test.ts --bundle --platform=node --format=cjs --outfile=scripts/_history.cjs && node scripts/_history.cjs && node -e \"require('fs').unlinkSync('scripts/_history.cjs')\"",
    "test:architecture": "node scripts/architecture-check.cjs",
    "test": "npm run typecheck && npm run test:architecture && npm run test:editor && npm run test:geometry && npm run test:history && npm run test:print && npm run test:render && npm run test:workspace",
    "test:print": "esbuild scripts/print-engine.test.ts --bundle --platform=node --format=cjs --outfile=scripts/_t.cjs --external:electron && node scripts/_t.cjs && node -e \"require('fs').unlinkSync('scripts/_t.cjs')\"",
    "fixtures:print": "esbuild scripts/generate-protocol-fixtures.ts --bundle --platform=node --format=cjs --outfile=scripts/_fixtures.cjs && node scripts/_fixtures.cjs && node -e \"require('fs').unlinkSync('scripts/_fixtures.cjs')\"",
    "dist": "npm run build && node scripts/build-windows.cjs",
    "dist:dir": "npm run build && node scripts/build-dir.cjs"
  },
  "build": {
    "appId": "com.maxlabel.app",
    "productName": "MaxLabel",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/iconv-lite/**/*"
    ],
    "extraResources": [
      {
        "from": "docs/labelshop-help-zh",
        "to": "docs/labelshop-help-zh"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MaxLabel-Setup-${version}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MaxLabel"
    }
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "bwip-js": "^4.4.1",
    "fabric": "7.4.0",
    "iconv-lite": "^0.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bwip-js": "^3.0.7",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.4",
    "electron-vite": "^5.0.0",
    "typescript": "^5.5.4",
    "vite": "^7.3.6",
    "ws": "^8.21.3"
  }
}
