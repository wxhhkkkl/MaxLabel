{
  "name": "maxlabel",
  "version": "0.1.0",
  "description": "MaxLabel —— 桌面端条码标签设计打印软件（LabelShop 复刻，专业版）",
  "main": "./out/main/index.js",
  "author": "MaxLabel",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:print": "esbuild scripts/print-engine.test.ts --bundle --platform=node --format=cjs --outfile=scripts/_t.cjs --external:electron && node scripts/_t.cjs && node -e \"require('fs').unlinkSync('scripts/_t.cjs')\"",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.maxlabel.app",
    "productName": "MaxLabel",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/iconv-lite/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MaxLabel-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MaxLabel"
    }
  },
  "dependencies": {
    "bwip-js": "^4.4.1",
    "fabric": "^6.4.3",
    "iconv-lite": "^0.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bwip-js": "^3.0.7",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "ws": "^8.21.3"
  }
}
